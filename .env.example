# Copie para .env.local (gitignored). Nunca use a chave service_role.

# --- Obrigatórias no modo real ---
# demo (padrão) ou real. Hospedado: sempre real.
NEWPORT_MODO=demo

# Mesmo valor de VITE_SUPABASE_URL do front (https://<ref>.supabase.co).
SUPABASE_URL=

# Opcional: só se o projeto ainda assinar JWT com HS256 legado.
# Deixe vazio; o backend lê as chaves públicas (JWKS) do Supabase.
SUPABASE_JWT_SECRET=

# UUID do usuário dono dos estudos anteriores à autenticação. Opcional.
# BENEFITS_DONO_LEGADO_ID=

# --- Hospedagem (Railway, uma instância) ---
# NEWPORT_HOSTED=1
# NEWPORT_BIND_HOST=0.0.0.0
# NEWPORT_VOLUME_DIR=/data
# NEWPORT_CORS_ORIGENS=https://seu-dominio.up.railway.app

# --- Caminhos (padrão = comportamento atual se ausentes) ---
# NEWPORT_DATA_DIR=            # demo: bancos em .data
# NEWPORT_PRIVATE_RUNTIME=     # real local: .private/runtime
# NEWPORT_DOCS_DIR=            # catálogos CSV/xlsx (padrão: docs/)
# NEWPORT_WEB_DIST=            # front compilado (padrão: web/dist)
# NEWPORT_REDE_XLSX=           # override da planilha SiscorNet
# NEWPORT_UPLOAD_MAX_BYTES=    # padrão 10485760 (10 MiB)

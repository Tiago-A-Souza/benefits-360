# Copie para web/.env.local (gitignored). Entram no bundle no `npm run build`.
# Nunca use a chave service_role. Só a chave anon (pública).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Piloto: faixa visível no topo. Desliga com 0 (ou omita) sem mudar código.
VITE_FAIXA_RASCUNHO=1

# Para gerar o dist da hospedagem (PowerShell), sem gravar o .env.local:
#   $env:VITE_SUPABASE_URL="https://<ref>.supabase.co"
#   $env:VITE_SUPABASE_ANON_KEY="<chave anon>"
#   $env:VITE_FAIXA_RASCUNHO="1"
#   npm run build
